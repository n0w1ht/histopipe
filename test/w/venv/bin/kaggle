#!/bin/bash
echo "KAGGLE $*" >> "$LOGF"
f=""; p=""; while [ $# -gt 0 ]; do case $1 in -f) f=$2; shift;; -p) p=$2; shift;; esac; shift; done
b=$(basename "$f")
case "$b" in
  *nomask*_mask.tiff) echo "404 - Not Found"; exit 1;;
  denied*) echo "403 - Forbidden"; exit 1;;
  train.csv) printf 'image_id,data_provider,isup_grade,gleason_score\r\nr0a,radboud,0,negative\r\nr0b,radboud,0,negative\r\nr3a,radboud,3,4+3\r\nr5a,radboud,5,5+5\r\nk1,karolinska,1,3+3\r\n' > "$p/$b";;
  zipped*) (cd "$p" && echo data > "$b" && python3 -m zipfile -c "$b.zip" "$b" && rm "$b");;
  *) echo data > "$p/$b";;
esac
echo "Downloading $b 100%"
