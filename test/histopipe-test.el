;;; histopipe-test.el --- Tests with stub HistoPrep, HistoEncoder and kaggle executables in w/venv/bin  -*- lexical-binding: t; -*-
(require 'ert) (require 'histopipe)
(defvar w (expand-file-name "w/" (file-name-directory (or load-file-name buffer-file-name))))
(setenv "LOGF" (expand-file-name "log" w))
;; Copies of the stubs can lose their executable bit.
(dolist (f (directory-files (expand-file-name "venv/bin" w) t "\\`[^.]"))
  (set-file-modes f #o755))
(defun wait-done ()
  (with-timeout (20 (error "timeout"))
    (while (or (process-live-p histopipe--process) histopipe--queue) (accept-process-output nil 0.1)))
  (accept-process-output nil 0.2))
(defun log-text () (with-current-buffer "*histopipe*" (buffer-string)))
(ert-deftest histopipe-full-run ()
  (let ((histopipe-venv (expand-file-name "venv" w))
        (histopipe-slides-directory (expand-file-name "slides" w))
        (histopipe-tiles-directory (expand-file-name "tiles" w))
        (histopipe-clusters '(8 16)) (histopipe-avg-pool t))
    (delete-directory histopipe-tiles-directory t) (ignore-errors (delete-file (getenv "LOGF")))
    (should-error (histopipe--extract-command) :type 'user-error)
    (histopipe-run 1) (wait-done)
    (message "%s" (log-text))
    (should (string-match-p "Cutting 100%\nok\n" (log-text)))
    (should-not (string-match-p "\r" (log-text)))
    (should (string-match-p "Finished: 2 of 2" (log-text)))
    (should (string-match-p "--avg-pool" (log-text)))
    ;; rerun skips tile and extract
    (histopipe-run 1) (wait-done)
    (should (string-match-p "tile: all 2 slides already tiled, skipping" (log-text)))
    (should (string-match-p "extract: features exist for all 2 slides" (log-text)))
    (should (string-match-p "--num-clusters 8 --num-clusters 16" (log-text)))
    ;; cluster with explicit numbers
    (histopipe-cluster '(4)) (wait-done)
    (should (string-match-p "--num-clusters 4\\b" (log-text)))
    ;; overwrite
    (histopipe-run-steps (quote (tile extract)) t) (wait-done)
    (should (string-match-p "--unfinished --overwrite" (log-text)))
    (should (string-match-p "--avg-pool --overwrite" (log-text)))))
(ert-deftest histopipe-failure-stops ()
  (let* ((histopipe-venv (expand-file-name "venv" w))
         (histopipe-slides-directory (expand-file-name "slides" w))
         (histopipe-tiles-directory (expand-file-name "tiles2" w)))
    (delete-directory histopipe-tiles-directory t)
    (cl-letf (((symbol-function 'histopipe--tile-command)
               (lambda () (cons "fail" (list "sh" "-c" "echo boom; exit 2")))))
      (histopipe-run 1) (wait-done))
    (should (string-match-p "tile failed (exit 2)" (log-text)))
    (should-not (string-match-p "==> extract" (log-text)))))
(ert-deftest histopipe-status-lists ()
  (let ((histopipe-slides-directory (expand-file-name "slides" w))
        (histopipe-tiles-directory (expand-file-name "status-tiles" w)))
    (delete-directory histopipe-tiles-directory t)
    (make-directory (expand-file-name "a/tiles" histopipe-tiles-directory) t)
    (dolist (f '("a/metadata.parquet" "a/features.parquet" "a/clusters.parquet"
                 "a/tiles/x0_y0_w512_h512.jpeg"))
      (write-region "" nil (expand-file-name f histopipe-tiles-directory)))
    (histopipe-status)
    (with-current-buffer "*histopipe-status*"
      (should (string-match-p "a +1 +yes +yes" (buffer-string)))
      (should (string-match-p "b +- +- +-" (buffer-string))))))

(defmacro with-kaggle (&rest body)
  `(let ((histopipe-venv (expand-file-name "venv" w))
         (histopipe-slides-directory (expand-file-name "k/slides" w))
         (histopipe-masks-directory (expand-file-name "k/masks" w))
         (histopipe-train-csv (expand-file-name "k/train.csv" w))
         (histopipe-tiles-directory (expand-file-name "k/tiles" w)))
     ,@body))

(ert-deftest histopipe-slide-id ()
  (should (equal (histopipe--slide-id "0005f7aaab2800f6170c399693a96917.tiff") "0005f7aaab2800f6170c399693a96917"))
  (should (equal (histopipe--slide-id "train_label_masks/abc_mask.tiff") "abc"))
  (should (equal (histopipe--slide-id " abc ") "abc")))
(ert-deftest histopipe-download-ids ()
  (with-kaggle
   (delete-directory (expand-file-name "k" w) t)
   (histopipe-download-slides '("0005f7aaab2800f6170c399693a96917.tiff" "zipped1" "nomask1") t)
   (wait-done) (message "%s" (log-text))
   (should (file-exists-p (expand-file-name "k/slides/0005f7aaab2800f6170c399693a96917.tiff" w)))
   (should (file-exists-p (expand-file-name "k/masks/0005f7aaab2800f6170c399693a96917_mask.tiff" w)))
   (should (file-exists-p (expand-file-name "k/slides/zipped1.tiff" w)))
   (should-not (file-exists-p (expand-file-name "k/slides/zipped1.tiff.zip" w)))
   (should (file-exists-p (expand-file-name "k/slides/nomask1.tiff" w)))
   (should (string-match-p "failed (exit 1), continuing" (log-text)))
   (should (string-match-p "Finished: 3 slides" (log-text)))
   ;; second time everything is skipped
   (histopipe-download-slides '("zipped1") nil) (wait-done)
   (should (string-match-p "zipped1.tiff already in" (log-text)))))
(ert-deftest histopipe-download-denied ()
  (with-kaggle
   (histopipe-download-slides '("denied1" "after1") nil) (wait-done)
   (message "%s" (log-text))
   (should (string-match-p "accept the rules" (log-text)))
   (should-not (file-exists-p (expand-file-name "k/slides/after1.tiff" w)))))
(ert-deftest histopipe-sample ()
  (with-kaggle
   (delete-directory (expand-file-name "k" w) t)
   (histopipe-download-sample 3 "radboud" nil) (wait-done)
   (message "%s" (log-text))
   (let ((got (sort (mapcar #'file-name-base (histopipe--slide-files)) #'string<)))
     (should (= (length got) 3))
     (should (member "r3a" got)) (should (member "r5a" got))
     (should-not (member "k1" got)))
   ;; next sample takes the remaining radboud slide only
   (histopipe-download-sample 5 "radboud" nil) (wait-done)
   (should (= (length (histopipe--slide-files)) 4))))

(ert-deftest histopipe-csv ()
  "Needs HISTOPIPE_POLARS_VENVS: venvs with polars, separated by the path separator,
and HISTOPIPE_TEST_PARQUET: a folder with features.parquet and clusters.parquet."
  (skip-unless (getenv "HISTOPIPE_POLARS_VENVS"))
  (dolist (venv (split-string (getenv "HISTOPIPE_POLARS_VENVS") path-separator t))
    (let ((histopipe-venv venv)
          (histopipe-tiles-directory (expand-file-name "csv" w)))
      (delete-directory histopipe-tiles-directory t)
      (make-directory (expand-file-name "s1" histopipe-tiles-directory) t)
      (copy-file (expand-file-name "features.parquet" (getenv "HISTOPIPE_TEST_PARQUET")) (expand-file-name "s1/features.parquet" histopipe-tiles-directory))
      (copy-file (expand-file-name "clusters.parquet" (getenv "HISTOPIPE_TEST_PARQUET")) (expand-file-name "s1/clusters.parquet" histopipe-tiles-directory))
      (histopipe-slide-to-csv "s1")
      (with-timeout (30 (error "timeout"))
        (while (get-process "histopipe-csv") (accept-process-output nil 0.1)))
      (with-temp-buffer
        (insert-file-contents (expand-file-name "s1/features.csv" histopipe-tiles-directory))
        (should (looking-at "tile,x,y,w,h,feat1"))
        (should (re-search-forward "^x0_y0_w512_h512.jpeg,0,0,512,512,0\\.[0-9]\\{1,4\\}," nil t)))
      (with-temp-buffer
        (insert-file-contents (expand-file-name "s1/clusters.csv" histopipe-tiles-directory))
        (should (looking-at "tile,x,n_clusters=8\nx0.jpeg,0,0"))))))

(ert-deftest histopipe-untiled-slide ()
  (let ((histopipe-tiles-directory (expand-file-name "none" w)))
    (should (string-match-p "abc is not tiled yet"
                           (cadr (should-error (histopipe-slide-to-csv "abc") :type 'user-error))))
    (should-error (histopipe-status-open "abc") :type 'user-error)
    (let ((histopipe-view-script "v.py"))
      (should-error (histopipe-view-slide "abc") :type 'user-error))))

(ert-deftest histopipe-views-and-names ()
  "Needs HISTOPIPE_POLARS_VENVS (venvs with polars and pillow) and
HISTOPIPE_TEST_VIEWS: a slide folder with tiles/, clusters.parquet and thumbnail.jpeg."
  (skip-unless (and (getenv "HISTOPIPE_POLARS_VENVS") (getenv "HISTOPIPE_TEST_VIEWS")))
  (dolist (venv (split-string (getenv "HISTOPIPE_POLARS_VENVS") path-separator t))
    (let* ((histopipe-venv venv)
           (histopipe-tiles-directory (expand-file-name "views" w))
           (histopipe-slides-directory (expand-file-name "noslides" w))
           (views (expand-file-name "views/s1/cluster_views" w)))
      (delete-directory histopipe-tiles-directory t)
      (make-directory histopipe-tiles-directory t)
      (copy-directory (getenv "HISTOPIPE_TEST_VIEWS") (expand-file-name "s1" histopipe-tiles-directory))
      (cl-letf (((symbol-function 'dired-other-window) #'ignore))
        (histopipe-view-slide "s1") (wait-done))
      (message "%s" (log-text))
      (dolist (f '("cluster_0.jpg" "cluster_7.jpg" "overlay.jpg" "summary.csv"))
        (should (file-exists-p (expand-file-name f views))))
      ;; Name clusters 0 and 3, skip the rest.
      (let ((answers '("stroma" "" "" "tumour glands, G4" "" "" "" "")))
        (cl-letf (((symbol-function 'read-string) (lambda (_p &optional _i _h default) (let ((a (pop answers))) (if (equal a "") (or default "") a))))
                  ((symbol-function 'dired-other-window) #'ignore))
          (histopipe-name-clusters "s1") (wait-done)))
      (should (equal (histopipe--read-names)
                     '(("n_clusters=8" 0 "stroma") ("n_clusters=8" 3 "tumour glands, G4"))))
      (with-temp-buffer
        (insert-file-contents (expand-file-name "summary.csv" views))
        (should (search-forward "0,stroma," nil t))
        (should (search-forward "3,\"tumour glands, G4\"," nil t)))
      ;; Renaming keeps others, "-" removes.
      (let ((answers '("-" "" "" "" "" "" "" "")))
        (cl-letf (((symbol-function 'read-string) (lambda (_p &optional _i _h default) (let ((a (pop answers))) (if (equal a "") (or default "") a))))
                  ((symbol-function 'dired-other-window) #'ignore))
          (histopipe-name-clusters "s1") (wait-done)))
      (should (equal (histopipe--read-names) '(("n_clusters=8" 3 "tumour glands, G4"))))
      ;; Another clustering
      (cl-letf (((symbol-function 'dired-other-window) #'ignore))
        (histopipe-view-slide "s1" "n_clusters=4") (wait-done))
      (should-not (file-exists-p (expand-file-name "cluster_7.jpg" views)))
      (should (string-match-p "cluster_views for s1 (n_clusters=4)" (log-text))))))

(ert-deftest histopipe-views-after-cluster-queued ()
  (let ((histopipe-venv (expand-file-name "venv" w))
        (histopipe-slides-directory (expand-file-name "slides" w))
        (histopipe-tiles-directory (expand-file-name "tiles" w)))
    (histopipe-run-steps '(cluster)) (wait-done)
    (should (string-match-p "==> views a: cluster_views for a (n_clusters=8)" (log-text)))
    (should (string-match-p "==> views b:" (log-text)))
    (should (string-match-p "Finished: 2 of 2" (log-text)))))

(ert-deftest histopipe-pnd ()
  (let ((histopipe-venv (expand-file-name "venv" w))
        (histopipe-slides-directory (expand-file-name "slides" w))
        (histopipe-tiles-directory (expand-file-name "pnd-tiles" w))
        (histopipe-train-csv (expand-file-name "train.csv" w))
        (histopipe-pnd-script (expand-file-name "pnd/pnd_predict.py" w))
        (histopipe-pnd-directory (expand-file-name "pnd" w))
        (histopipe-pnd-holdout t) (histopipe-pnd-speed 'no-tta) (histopipe-pnd-threads 2))
    (delete-directory histopipe-tiles-directory t)
    (make-directory histopipe-tiles-directory t)
    (histopipe-pnd-predict-all) (wait-done)
    (message "%s" (log-text))
    (should (string-match-p "==> PND weights: found in" (log-text)))
    (should (string-match-p "--holdout --no-tta --threads 2" (log-text)))
    (should-not (string-match-p "--redo" (log-text)))
    (should (string-match-p "Finished: 2 slides graded .*; 1 of 2 match the true ISUP grade" (log-text)))
    (histopipe-status)
    (with-current-buffer "*histopipe-status*"
      (should (string-match-p "a +- +- +- +2 +2" (buffer-string)))
      (should (string-match-p "b +- +- +- +3 +2" (buffer-string))))
    ;; One slide, fast, regraded.
    (let ((histopipe-pnd-speed 'fast) (histopipe-pnd-holdout nil))
      (histopipe-pnd-predict-slide "b") (wait-done))
    (should (string-match-p "slides/b\\.tiff --pnd-dir" (log-text)))
    (should (string-match-p "--fast --threads 2 --redo" (log-text)))
    (should-not (string-match-p "--holdout" (log-text)))
    ;; Missing weights are cloned with git.
    (let ((histopipe-pnd-directory (expand-file-name "no-pnd" w)))
      (should (member "clone" (cdr (funcall (nth 1 (histopipe--pnd-clone-step)))))))
    (let ((histopipe-pnd-script (expand-file-name "missing.py" w)))
      (should-error (histopipe-pnd-predict-all) :type 'user-error))))
